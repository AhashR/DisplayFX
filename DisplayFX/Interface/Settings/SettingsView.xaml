<Window x:Class="DisplayFX.Interface.Settings.SettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
 Width="700" SizeToContent="Height" ResizeMode="CanMinimize" Title="Settings" WindowStyle="SingleBorderWindow" Style="{x:Null}"
 WindowStartupLocation="CenterOwner" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1"
 Icon="pack://application:,,,/DisplayFX;component/Resources/desktop.png">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}"/><Setter Property="Padding" Value="8,5"/>
  </Style>
 </Window.Resources>
 <Grid Margin="16" Background="{DynamicResource WindowBackgroundBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="16" VerticalAlignment="Top">
   <StackPanel>
    <TextBlock Text="General" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,16"/>
    <CheckBox Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding IsStartWithWindows}" Content="Launch with Windows" Margin="0,0,0,16"/>
    <CheckBox Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding IsStartMinimized}" Content="Start minimised" Margin="0,0,0,16"/>
    <CheckBox Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding IsMinimizeToTray}" Content="Close to tray" Margin="0,0,0,16" ToolTip="The close button keeps DisplayFX running in the tray"/>
    <CheckBox Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding IsApplySettingsOnStart}" Content="Restore colour profiles" Margin="0,0,0,16" ToolTip="Apply the active saved profile on launch"/>
    <CheckBox Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding IsRememberBrightnessOnStart}" Content="Restore brightness" ToolTip="Restore the last successful brightness on launch"/>
    <Border Height="1" Background="{DynamicResource BorderColorBrush}" Margin="0,20"/>
    <TextBlock Text="Settings backup" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10"/>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Button Name="BackupSettings" Style="{DynamicResource DarkThemeButtonStyle}" ToolTip="Back up saved profiles and settings" AutomationProperties.Name="Back up settings">
      <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE896;" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Back up"/></StackPanel>
     </Button>
     <Button Grid.Column="2" Name="RestoreSettings" Style="{DynamicResource DarkThemeButtonStyle}" ToolTip="Restore a DisplayFX settings backup" AutomationProperties.Name="Restore settings">
      <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B5;" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Restore"/></StackPanel>
     </Button>
    </Grid>
   </StackPanel>
  </Border>
  <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="16">
   <StackPanel>
    <CheckBox Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding IsBrightnessShortcutsEnabled}" Content="Brightness shortcuts" Margin="0,0,0,10"/>
    <Grid IsEnabled="{Binding IsBrightnessShortcutsEnabled}">
     <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
     <TextBlock Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" ToolTip="Increase brightness"/>
     <Button Grid.Column="1" Content="{Binding IncreaseShortcutText}" Click="IncreaseShortcut_Click" PreviewKeyDown="Shortcut_PreviewKeyDown" LostKeyboardFocus="Shortcut_LostKeyboardFocus" Style="{DynamicResource DarkThemeButtonStyle}" Margin="0,0,0,6" ToolTip="Record increase shortcut" AutomationProperties.Name="Increase brightness shortcut"/>
     <TextBlock Grid.Row="1" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" ToolTip="Decrease brightness"/>
     <Button Grid.Row="1" Grid.Column="1" Content="{Binding DecreaseShortcutText}" Click="DecreaseShortcut_Click" PreviewKeyDown="Shortcut_PreviewKeyDown" LostKeyboardFocus="Shortcut_LostKeyboardFocus" Style="{DynamicResource DarkThemeButtonStyle}" Margin="0,0,0,6" ToolTip="Record decrease shortcut" AutomationProperties.Name="Decrease brightness shortcut"/>
     <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="Step (%)" VerticalAlignment="Center" FontSize="12"/>
     <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding BrightnessShortcutStep, UpdateSourceTrigger=LostFocus}" Width="60" HorizontalAlignment="Right" AutomationProperties.Name="Brightness step percent"/>
    </Grid>
    <Border Height="1" Background="{DynamicResource BorderColorBrush}" Margin="0,16"/>
    <CheckBox Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding IsBrightnessScheduleEnabled}" Content="Daily brightness" Margin="0,0,0,10" ToolTip="Local time; after sleep, the latest due level is applied"/>
    <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
     <TextBlock Text="Time" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/><TextBlock Grid.Column="1" Text="Brightness (%)" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
    </Grid>
    <ItemsControl ItemsSource="{Binding VisibleSchedules}"><ItemsControl.ItemTemplate><DataTemplate>
     <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
      <TextBox Text="{Binding Time, UpdateSourceTrigger=LostFocus}" Margin="0,0,8,0" ToolTip="24-hour time (HH:mm)" AutomationProperties.Name="Daily time"/>
      <TextBox Grid.Column="1" Text="{Binding Brightness, UpdateSourceTrigger=LostFocus}" Margin="0,0,8,0" ToolTip="Brightness from 0 to 100" AutomationProperties.Name="Scheduled brightness percent"/>
      <Button Grid.Column="2" Content="&#xE74D;" Click="RemoveSchedule_Click" Style="{DynamicResource IconButtonStyle}" ToolTip="Remove time" AutomationProperties.Name="Remove scheduled time"/>
     </Grid>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Visibility="{Binding HasSchedulePages, Converter={StaticResource BoolVisibility}}">
     <Button Name="PreviousSchedulePage" Content="&#xE76B;" Style="{DynamicResource IconButtonStyle}" IsEnabled="{Binding CanPreviousSchedulePage}" ToolTip="Previous times" AutomationProperties.Name="Previous scheduled times"/>
     <TextBlock Text="{Binding SchedulePageText}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" Margin="4,0"/>
     <Button Name="NextSchedulePage" Content="&#xE76C;" Style="{DynamicResource IconButtonStyle}" IsEnabled="{Binding CanNextSchedulePage}" ToolTip="Next times" AutomationProperties.Name="Next scheduled times"/>
    </StackPanel>
    <Grid Margin="0,10,0,0">
     <Button Name="AddSchedule" Content="&#xE710;" Style="{DynamicResource IconButtonStyle}" HorizontalAlignment="Left" ToolTip="Add time" AutomationProperties.Name="Add scheduled time"/>
     <Button Content="&#xE74E;" Click="SaveBrightnessAutomation_Click" Style="{DynamicResource PrimaryIconButtonStyle}" HorizontalAlignment="Right" ToolTip="Save brightness shortcuts and schedule" AutomationProperties.Name="Save brightness settings"/>
    </Grid>
   </StackPanel>
  </Border>
  <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
   <TextBlock Text="{Binding SettingsStatus}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SettingsStatus}" FontSize="12" Foreground="{DynamicResource AccentBlueBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
   <Button Grid.Column="1" Name="Done" Content="&#xE73E;" Style="{DynamicResource IconButtonStyle}" ToolTip="Done" AutomationProperties.Name="Done"/>
  </Grid>
 </Grid>
</Window>
