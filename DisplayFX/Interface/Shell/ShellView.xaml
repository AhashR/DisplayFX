<Window FontSize="{DynamicResource ContentFontSize}" x:Class="DisplayFX.Interface.Shell.ShellView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:cm="http://caliburnmicro.com" MinHeight="420" MinWidth="600" Width="790" FontFamily="Segoe UI" Language="en-GB" UseLayoutRounding="True" SizeToContent="Height" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" WindowStyle="SingleBorderWindow" Style="{x:Null}" Title="DisplayFX" Icon="pack://application:,,,/DisplayFX;component/Resources/desktop.png" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderColorBrush}">
    <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility" /></Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="188" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border x:Name="NavigationRail" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10,14,10,12">
                        <TextBlock Text="Displays" FontWeight="SemiBold" Margin="8,0,0,6" />
                        <ItemsControl x:Name="DisplayNavigation" ItemsSource="{Binding VisibleMonitors}">
                            <ItemsControl.ItemTemplate><DataTemplate><ContentControl cm:View.Model="{Binding}" IsTabStop="False" /></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="8,15,0,4">
                            <TextBlock Text="{DynamicResource UiText535E52E4A261}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Name="AddProfile" Content="" Style="{DynamicResource FluentIconButtonStyle}" HorizontalAlignment="Right"
                                    IsEnabled="{Binding CanAddProfile}" ToolTip="{DynamicResource UiTextFCF4F3F4D5F7}" AutomationProperties.Name="Add profile" />
                        </Grid>
                        <ItemsControl x:Name="ProfileNavigation" ItemsSource="{Binding VisibleProfiles}">
                            <ItemsControl.ItemTemplate><DataTemplate><ContentControl cm:View.Model="{Binding}" IsTabStop="False" /></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="18,14,18,16" x:Name="EditorPane">
                    <TextBlock x:Name="SelectedDisplayName" Text="{Binding SelectedMonitor.Name}" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SelectedProfileHeading" Text="{Binding SelectedProfile.Name, TargetNullValue=Display settings}" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,1,0,9" />
                    <ContentControl cm:View.Model="{Binding SelectedProfile.ProfileSettings}" IsTabStop="False" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderColorBrush}" Background="{DynamicResource SidebarBackgroundBrush}">
            <Grid Margin="9,7">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                <Button Name="IdentifyMonitors" AutomationProperties.Name="Identify displays" Content="" Style="{DynamicResource FluentIconButtonStyle}" IsEnabled="{Binding CanIdentifyMonitors}" ToolTip="{DynamicResource UiTextD5E2BA51BF04}" />
                <Button Name="RefreshMonitors" AutomationProperties.Name="Refresh displays" Content="" Style="{DynamicResource FluentIconButtonStyle}" ToolTip="{DynamicResource UiTextD28CEE938975}" />
                <Button Name="OpenSettings" AutomationProperties.Name="Settings" Content="" Style="{DynamicResource FluentIconButtonStyle}" ToolTip="{DynamicResource UiText74A883A037BC}" />
            </StackPanel>
                <TextBlock Grid.Column="1" Text="{DynamicResource UiTextA710C2B90913}" Foreground="{DynamicResource TextMutedBrush}"
                           TextTrimming="CharacterEllipsis" Margin="8,0" VerticalAlignment="Center"
                           Visibility="{Binding ProfileSettingsIsDirty, Converter={StaticResource BoolVisibility}}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBlock Text="{Binding StatusIcon}" FontFamily="Segoe MDL2 Assets" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,10,0" Padding="6" Background="Transparent" Visibility="{Binding HasOperationStatus, Converter={StaticResource BoolVisibility}}" ToolTip="{Binding OperationStatus}" />
                <Button Name="Revert" Content="{Binding RevertActionLabel}" Style="{DynamicResource FluentButtonStyle}" IsEnabled="{Binding ProfileSettingsIsDirty}" ToolTip="{DynamicResource UiText80DCF958AA50}" Margin="0,0,6,0" />
                <Button Name="Apply" MinWidth="74" Content="{Binding ApplyActionLabel}" Style="{DynamicResource FluentButtonStyle}" IsEnabled="{Binding CanApply}" ToolTip="{DynamicResource UiTextF1BB69715A57}" Margin="0,0,6,0" />
                <Button Name="Update" Content="{Binding SaveActionLabel}" Style="{DynamicResource FluentPrimaryButtonStyle}" IsEnabled="{Binding CanSave}" ToolTip="{DynamicResource UiText0C8209E72EC8}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
