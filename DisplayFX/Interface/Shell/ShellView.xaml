<Window x:Class="DisplayFX.Interface.Shell.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cm="http://caliburnmicro.com"
    MinHeight="400" MinWidth="620" Width="640" SizeToContent="Height" WindowStartupLocation="CenterScreen"
    ResizeMode="CanMinimize" WindowStyle="SingleBorderWindow" Style="{x:Null}" Title="{Binding DisplayName}"
    Icon="pack://application:,,,/DisplayFX;component/Resources/desktop.png"
    Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
    BorderThickness="1" BorderBrush="{DynamicResource BorderColorBrush}">
    <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/></Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Monitors}">
                    <ItemsControl.ItemTemplate><DataTemplate><ContentControl cm:View.Model="{Binding}" IsTabStop="False"/></DataTemplate></ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                <Button Name="IdentifyMonitors" Content="&#xE7F4;" Style="{DynamicResource IconButtonStyle}" IsEnabled="{Binding CanIdentifyMonitors}" ToolTip="Identify displays" AutomationProperties.Name="Identify displays"/>
                <Button Name="RefreshMonitors" Content="&#xE72C;" Style="{DynamicResource IconButtonStyle}" ToolTip="Refresh displays" AutomationProperties.Name="Refresh displays"/>
                <Button Name="OpenSettings" Content="&#xE713;" Style="{DynamicResource IconButtonStyle}" ToolTip="Settings" AutomationProperties.Name="Settings"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="172"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Profiles" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    <Button Name="AddProfile" Content="&#xE710;" Style="{DynamicResource IconButtonStyle}" HorizontalAlignment="Right" IsEnabled="{Binding CanAddProfile}" ToolTip="New profile" AutomationProperties.Name="New profile"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding SelectedMonitor.Profiles}">
                    <ItemsControl.ItemTemplate><DataTemplate><ContentControl cm:View.Model="{Binding}" IsTabStop="False"/></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl cm:View.Model="{Binding SelectedProfile.ProfileSettings}" IsTabStop="False"/>
            </ScrollViewer>
        </Grid>
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <TextBlock Text="Unsaved changes" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                       Visibility="{Binding ProfileSettingsIsDirty, Converter={StaticResource BoolVisibility}}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="#F0B86E" VerticalAlignment="Center" Margin="0,0,10,0"
                           Visibility="{Binding HasOperationStatus, Converter={StaticResource BoolVisibility}}" ToolTip="{Binding OperationStatus}"/>
                <Button Name="Revert" Content="&#xE7A7;" Style="{DynamicResource IconButtonStyle}" IsEnabled="{Binding ProfileSettingsIsDirty}" ToolTip="Revert edits" AutomationProperties.Name="Revert edits" Margin="0,0,6,0"/>
                <Button Name="Apply" Content="&#xE768;" Style="{DynamicResource IconButtonStyle}" IsEnabled="{Binding CanApply}" ToolTip="Apply profile / preview edits" AutomationProperties.Name="Apply profile" Margin="0,0,6,0"/>
                <Button Name="Update" Content="&#xE74E;" Style="{DynamicResource PrimaryIconButtonStyle}" IsEnabled="{Binding ProfileSettingsIsDirty}" ToolTip="Save profile" AutomationProperties.Name="Save profile"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
