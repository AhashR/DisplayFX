<Window FontSize="{DynamicResource ContentFontSize}" x:Class="DisplayFX.Interface.BrightnessFlyout.BrightnessFlyoutView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="320" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True" Title="{DynamicResource UiTextEC811D30A89C}" Foreground="{DynamicResource TextPrimaryBrush}">
 <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility" /></Window.Resources>
 <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1" CornerRadius="14" Padding="20,18,20,12">
  <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420"><ItemsControl ItemsSource="{Binding Monitors}">
    <ItemsControl.ItemTemplate><DataTemplate>
     <StackPanel Margin="0,0,0,16">
      <Grid Margin="0,0,0,6">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
       <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource ContentFontSize}" ToolTip="{Binding Name}" />
       <TextBlock Grid.Column="1" Text="" FontFamily="Segoe MDL2 Assets" Foreground="#F0B86E" Margin="8,0" VerticalAlignment="Center" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}" ToolTip="{Binding StatusMessage}" />
       <TextBlock Grid.Column="2" Text="{Binding BrightnessText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource ContentFontSize}" VerticalAlignment="Center" />
      </Grid>
      <TextBlock Text="{Binding Details}" Visibility="{Binding HasDetails, Converter={StaticResource BoolVisibility}}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
      <Slider Style="{DynamicResource BrightnessSliderStyle}" Minimum="0" Maximum="100" SmallChange="1" LargeChange="5" Value="{Binding Brightness}" IsEnabled="{Binding SupportsBrightness}" AutomationProperties.Name="{Binding Name}" />
     </StackPanel>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl></ScrollViewer>
   <StackPanel Grid.Row="1"><Border Height="1" Background="{DynamicResource BorderColorBrush}" Margin="0,0,0,8" />
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <ToggleButton IsChecked="{Binding IsLinked}" Style="{DynamicResource SegmentedTabToggleButtonStyle}" FontFamily="Segoe MDL2 Assets" Content="" FontSize="16" Width="36" Height="36" Padding="0" HorizontalAlignment="Left" ToolTip="{DynamicResource UiText6340406ECCF3}" AutomationProperties.Name="{DynamicResource UiText6340406ECCF3}" />
    <Button Grid.Column="1" Content="" Style="{DynamicResource IconButtonStyle}" Click="OpenMainApp_Click" ToolTip="{DynamicResource UiTextD6FDD7B5CCD1}" AutomationProperties.Name="{DynamicResource UiText6ED6424D45BE}" Margin="0,0,4,0" />
    <Button Grid.Column="2" Content="" Style="{DynamicResource IconButtonStyle}" Click="TurnOffMonitors_Click" ToolTip="{DynamicResource UiTextF2FB945958AB}" AutomationProperties.Name="{DynamicResource UiTextF2FB945958AB}" Margin="0,0,4,0" />
    <Button Grid.Column="3" Content="" Style="{DynamicResource IconButtonStyle}" Click="OpenSettings_Click" ToolTip="{DynamicResource UiText74A883A037BC}" AutomationProperties.Name="{DynamicResource UiText74A883A037BC}" />
   </Grid>
   <TextBlock Text="{Binding LinkStatus}" FontSize="{DynamicResource ContentFontSize}" Foreground="#F0B86E" TextWrapping="Wrap" />
  </StackPanel></Grid>
 </Border>
</Window>
