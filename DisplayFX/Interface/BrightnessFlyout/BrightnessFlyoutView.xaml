<Window x:Class="DisplayFX.Interface.BrightnessFlyout.BrightnessFlyoutView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="320" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
 ShowInTaskbar="False" Topmost="True" Title="Brightness" Foreground="{DynamicResource TextPrimaryBrush}">
 <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/></Window.Resources>
 <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1" CornerRadius="14" Padding="20,18,20,12">
  <StackPanel>
   <ItemsControl ItemsSource="{Binding Monitors}">
    <ItemsControl.ItemTemplate><DataTemplate>
     <StackPanel Margin="0,0,0,16">
      <Grid Margin="0,0,0,6">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="13" ToolTip="{Binding Name}"/>
       <TextBlock Grid.Column="1" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="#F0B86E" Margin="8,0" VerticalAlignment="Center"
           Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}" ToolTip="{Binding StatusMessage}"/>
       <TextBlock Grid.Column="2" Text="{Binding BrightnessText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center"/>
      </Grid>
      <Slider Style="{DynamicResource BrightnessSliderStyle}" Minimum="0" Maximum="100" SmallChange="1" LargeChange="5" Value="{Binding Brightness}" IsEnabled="{Binding SupportsBrightness}" AutomationProperties.Name="{Binding Name}"/>
     </StackPanel>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
   <Border Height="1" Background="{DynamicResource BorderColorBrush}" Margin="0,0,0,8"/>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ToggleButton IsChecked="{Binding IsLinked}" Style="{DynamicResource SegmentedTabToggleButtonStyle}" FontFamily="Segoe MDL2 Assets" Content="&#xE71B;" FontSize="16" Width="36" Height="36" Padding="0" HorizontalAlignment="Left" ToolTip="Link brightness controls" AutomationProperties.Name="Link brightness controls"/>
    <Button Grid.Column="1" Content="&#xE8A7;" Style="{DynamicResource IconButtonStyle}" Click="OpenMainApp_Click" ToolTip="Open DisplayFX" AutomationProperties.Name="Open main app" Margin="0,0,4,0"/>
    <Button Grid.Column="2" Content="&#xE7E8;" Style="{DynamicResource IconButtonStyle}" Click="TurnOffMonitors_Click" ToolTip="Turn off displays" AutomationProperties.Name="Turn off displays" Margin="0,0,4,0"/>
    <Button Grid.Column="3" Content="&#xE713;" Style="{DynamicResource IconButtonStyle}" Click="OpenSettings_Click" ToolTip="Settings" AutomationProperties.Name="Settings"/>
   </Grid>
   <TextBlock Text="{Binding LinkStatus}" FontSize="12" Foreground="#F0B86E" TextWrapping="Wrap"/>
  </StackPanel>
 </Border>
</Window>
