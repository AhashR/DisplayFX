<Window FontSize="{DynamicResource ContentFontSize}" x:Class="DisplayFX.Interface.BrightnessFlyout.BrightnessFlyoutView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="320" FontFamily="Segoe UI" UseLayoutRounding="True" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True" Title="{DynamicResource UiTextEC811D30A89C}" Foreground="{DynamicResource TextPrimaryBrush}">
 <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility" /></Window.Resources>
 <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12,14,7">
  <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420"><ItemsControl ItemsSource="{Binding Monitors}">
    <ItemsControl.ItemTemplate><DataTemplate>
     <StackPanel Margin="2,0,2,5">
      <Grid Margin="0,0,0,2">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
       <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource ContentFontSize}" ToolTip="{Binding Name}" />
       <TextBlock Grid.Column="1" Text="" FontFamily="Segoe MDL2 Assets" Foreground="#F0B86E" Margin="8,0" VerticalAlignment="Center" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}" ToolTip="{Binding StatusMessage}" />
       <TextBlock Grid.Column="2" Text="{Binding BrightnessText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource ContentFontSize}" VerticalAlignment="Center" />
      </Grid>
      <Slider Height="28" AutomationProperties.Name="{Binding Name}" Style="{DynamicResource BrightnessSliderStyle}" Minimum="0" Maximum="100" SmallChange="1" LargeChange="5" Value="{Binding Brightness}" IsEnabled="{Binding SupportsBrightness}" />
     </StackPanel>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl></ScrollViewer>
   <StackPanel Grid.Row="1"><Border Height="1" Background="{DynamicResource BorderColorBrush}" Margin="0,0,0,3" />
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <Button Grid.Column="1" x:Name="OpenDisplayFX" AutomationProperties.Name="Open DisplayFX" Content="" Style="{DynamicResource FluentIconButtonStyle}" Click="OpenMainApp_Click" ToolTip="{DynamicResource UiTextD6FDD7B5CCD1}" />
   </Grid>
   <TextBlock Text="{Binding LinkStatus}" FontSize="{DynamicResource ContentFontSize}" Foreground="#F0B86E" TextWrapping="Wrap">
    <TextBlock.Style>
     <Style TargetType="TextBlock">
      <Style.Triggers>
       <DataTrigger Binding="{Binding LinkStatus}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
       <DataTrigger Binding="{Binding LinkStatus}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
      </Style.Triggers>
     </Style>
    </TextBlock.Style>
   </TextBlock>
  </StackPanel></Grid>
 </Border>
</Window>
