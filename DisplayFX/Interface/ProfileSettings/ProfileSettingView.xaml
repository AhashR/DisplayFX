<UserControl x:Class="DisplayFX.Interface.ProfileSettings.ProfileSettingView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Foreground="{DynamicResource TextPrimaryBrush}">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/></UserControl.Resources>
 <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="20">
  <StackPanel><Grid Margin="0,0,0,16">
        <TextBlock Text="Brightness" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
        <TextBlock Text="{Binding Brightness, StringFormat=p0}" FontSize="13" HorizontalAlignment="Right"/>
        <Slider Margin="0,24,0,0" Style="{DynamicResource BrightnessSliderStyle}" Value="{Binding Brightness}" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.05" AutomationProperties.Name="Brightness"/>
    </Grid><Grid Margin="0,0,0,16">
        <TextBlock Text="Contrast" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
        <TextBlock Text="{Binding Contrast, StringFormat=p0}" FontSize="13" HorizontalAlignment="Right"/>
        <Slider Margin="0,24,0,0" Style="{DynamicResource BrightnessSliderStyle}" Value="{Binding Contrast}" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.05" AutomationProperties.Name="Contrast"/>
    </Grid><Grid Margin="0,0,0,16">
        <TextBlock Text="Vibrance" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
        <TextBlock Text="{Binding DigitalVibrance, StringFormat=p0}" FontSize="13" HorizontalAlignment="Right"/>
        <Slider Margin="0,24,0,0" Style="{DynamicResource BrightnessSliderStyle}" Value="{Binding DigitalVibrance}" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.05" AutomationProperties.Name="Vibrance"/>
    </Grid><Grid Margin="0,0,0,16">
        <TextBlock Text="Gamma" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
        <TextBlock Text="{Binding Gamma, StringFormat=n2}" FontSize="13" HorizontalAlignment="Right"/>
        <Slider Margin="0,24,0,0" Style="{DynamicResource BrightnessSliderStyle}" Value="{Binding Gamma}" Minimum="0.4" Maximum="2.8" SmallChange="0.01" LargeChange="0.05" AutomationProperties.Name="Gamma"/>
    </Grid>
    <Border Height="1" Background="{DynamicResource BorderColorBrush}" Margin="0,0,0,12"/>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
     <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" ToolTip="Profile shortcut"/>
     <ToggleButton Grid.Column="1" x:Name="HotkeyRecorderButton" IsChecked="{Binding IsRecordingHotkey}" Content="{Binding HotkeyDisplayText}"
        Style="{DynamicResource HotkeyRecorderButtonStyle}" PreviewKeyDown="HotkeyRecorderButton_PreviewKeyDown" LostKeyboardFocus="HotkeyRecorderButton_LostKeyboardFocus" ToolTip="Record profile shortcut" AutomationProperties.Name="Record profile shortcut"/>
     <Button Grid.Column="2" Content="&#xE711;" Style="{DynamicResource IconButtonStyle}" Command="{Binding ClearHotkeyCommand}" ToolTip="Clear shortcut" AutomationProperties.Name="Clear shortcut"/>
    </Grid>
    <Grid Margin="0,8,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
     <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" ToolTip="Linked application"/>
     <Button Grid.Column="1" Content="{Binding LinkedApplicationName}" Command="{Binding BrowseExecutableCommand}" Style="{DynamicResource DarkThemeButtonStyle}" ToolTip="{Binding LinkedExecutablePath}" AutomationProperties.Name="Link application" Padding="8,6"/>
     <Button Grid.Column="2" Content="&#xE711;" Command="{Binding ClearExecutableCommand}" Style="{DynamicResource IconButtonStyle}" ToolTip="Unlink application" AutomationProperties.Name="Unlink application"/>
    </Grid>
    <TextBlock Text="{Binding HotkeyStatus}" TextWrapping="Wrap" FontSize="12" Foreground="#F0B86E" Margin="0,8,0,0"
        Visibility="{Binding HasHotkeyStatus, Converter={StaticResource BoolVisibility}}"/>
  </StackPanel>
 </Border>
</UserControl>
