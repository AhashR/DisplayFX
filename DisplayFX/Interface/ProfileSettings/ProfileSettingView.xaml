<UserControl x:Class="DisplayFX.Interface.ProfileSettings.ProfileSettingView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource TextPrimaryBrush}">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility" /></UserControl.Resources>
 <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="20">
  <StackPanel><Grid Margin="0,0,0,16">
        <TextBlock Text="{DynamicResource UiText8D4FB8A3D94E}" FontSize="{DynamicResource ContentFontSize}" Foreground="{DynamicResource TextMutedBrush}" ToolTip="{DynamicResource UiTextCCA9C0469F8B}" />
        <TextBlock Text="{Binding Brightness, StringFormat=p0}" FontSize="{DynamicResource ContentFontSize}" HorizontalAlignment="Right" />
        <Slider Margin="0,24,0,0" Style="{DynamicResource BrightnessSliderStyle}" Value="{Binding Brightness}" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.05" AutomationProperties.Name="{DynamicResource UiText8D4FB8A3D94E}" />
    </Grid><Grid Margin="0,0,0,16">
        <TextBlock Text="{DynamicResource UiText08795BA031BC}" FontSize="{DynamicResource ContentFontSize}" Foreground="{DynamicResource TextMutedBrush}" />
        <TextBlock Text="{Binding Contrast, StringFormat=p0}" FontSize="{DynamicResource ContentFontSize}" HorizontalAlignment="Right" />
        <Slider Margin="0,24,0,0" Style="{DynamicResource BrightnessSliderStyle}" Value="{Binding Contrast}" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.05" AutomationProperties.Name="{DynamicResource UiText08795BA031BC}" />
    </Grid><Grid Margin="0,0,0,16">
        <TextBlock Text="{DynamicResource UiText54D47A0D2595}" FontSize="{DynamicResource ContentFontSize}" Foreground="{DynamicResource TextMutedBrush}" />
        <TextBlock Text="{Binding DigitalVibrance, StringFormat=p0}" FontSize="{DynamicResource ContentFontSize}" HorizontalAlignment="Right" />
        <Slider Margin="0,24,0,0" Style="{DynamicResource BrightnessSliderStyle}" Value="{Binding DigitalVibrance}" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.05" AutomationProperties.Name="{DynamicResource UiText54D47A0D2595}" />
    </Grid><Grid Margin="0,0,0,16">
        <TextBlock Text="{DynamicResource UiTextA8AB3D5805C9}" FontSize="{DynamicResource ContentFontSize}" Foreground="{DynamicResource TextMutedBrush}" />
        <TextBlock Text="{Binding Gamma, StringFormat=n2}" FontSize="{DynamicResource ContentFontSize}" HorizontalAlignment="Right" />
        <Slider Margin="0,24,0,0" Style="{DynamicResource BrightnessSliderStyle}" Value="{Binding Gamma}" Minimum="0.4" Maximum="2.8" SmallChange="0.01" LargeChange="0.05" AutomationProperties.Name="{DynamicResource UiTextA8AB3D5805C9}" />
    </Grid>
    <Expander Header="{DynamicResource UiTextE82E66F5EC15}" Margin="0,0,0,12" Foreground="{DynamicResource TextPrimaryBrush}">
     <StackPanel>
      <TextBlock Text="{DynamicResource UiTextAF77ECA71660}" TextWrapping="Wrap" Margin="0,6" />
      <TextBlock Text="{DynamicResource UiText1DC3F78BF078}" /><Slider Minimum="0" Maximum="1" Value="{Binding RedGain}" SmallChange="0.01" Style="{DynamicResource BrightnessSliderStyle}" AutomationProperties.Name="{DynamicResource UiText1DC3F78BF078}" />
      <TextBlock Text="{DynamicResource UiText89D76FDE8BCD}" /><Slider Minimum="0" Maximum="1" Value="{Binding GreenGain}" SmallChange="0.01" Style="{DynamicResource BrightnessSliderStyle}" AutomationProperties.Name="{DynamicResource UiText89D76FDE8BCD}" />
      <TextBlock Text="{DynamicResource UiText3A16DF3FCCDB}" /><Slider Minimum="0" Maximum="1" Value="{Binding BlueGain}" SmallChange="0.01" Style="{DynamicResource BrightnessSliderStyle}" AutomationProperties.Name="{DynamicResource UiText3A16DF3FCCDB}" />
      <TextBlock Text="{Binding TemperatureKelvin, StringFormat=Temperature tint: {0} K}" /><Slider Minimum="2500" Maximum="10000" Value="{Binding TemperatureKelvin}" SmallChange="250" TickFrequency="250" IsSnapToTickEnabled="True" Style="{DynamicResource BrightnessSliderStyle}" AutomationProperties.Name="{DynamicResource UiText87620FE94C6C}" />
     </StackPanel>
    </Expander>
    <Border Height="1" Background="{DynamicResource BorderColorBrush}" Margin="0,0,0,12" />
    <Expander Header="{DynamicResource UiText65BDCC9F3BF3}" Margin="0,0,0,12" Foreground="{DynamicResource TextPrimaryBrush}">
     <StackPanel Margin="0,8,0,0">
      <UniformGrid Columns="3">
       <TextBlock Text="{DynamicResource UiText62FF97AC4C6B}" /><TextBox Text="{Binding BrightnessInput, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource UiTextAD17EDDD3EEA}" /><Button Content="{DynamicResource UiTextDAEE7606B339}" Click="ResetBrightness_Click" />
       <TextBlock Text="{DynamicResource UiText9C602CE01F50}" /><TextBox Text="{Binding ContrastInput, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource UiText064F7BB753F3}" /><Button Content="{DynamicResource UiTextDAEE7606B339}" Click="ResetContrast_Click" />
       <TextBlock Text="{DynamicResource UiText047F9E0D8486}" /><TextBox Text="{Binding VibranceInput, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource UiText0A91C9649AE1}" /><Button Content="{DynamicResource UiTextDAEE7606B339}" Click="ResetVibrance_Click" />
       <TextBlock Text="{DynamicResource UiTextA8AB3D5805C9}" /><TextBox Text="{Binding GammaInput, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource UiText407D2557BB6F}" /><Button Content="{DynamicResource UiTextDAEE7606B339}" Click="ResetGamma_Click" />
      </UniformGrid>
      <TextBlock Text="{Binding InputError}" TextWrapping="Wrap" Foreground="#F0B86E" />
      <StackPanel Orientation="Horizontal"><Button Content="{DynamicResource UiTextA8283ADE3185}" Click="UndoColor_Click" IsEnabled="{Binding CanUndoColor}" /><Button Content="{DynamicResource UiText74273989B096}" Click="RedoColor_Click" IsEnabled="{Binding CanRedoColor}" Margin="8,0,0,0" /></StackPanel>
     </StackPanel>
    </Expander>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions>
     <TextBlock Text="" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" ToolTip="{DynamicResource UiText8877A2B70D7B}" />
     <ToggleButton Grid.Column="1" x:Name="HotkeyRecorderButton" IsChecked="{Binding IsRecordingHotkey}" Content="{Binding HotkeyDisplayText}" Style="{DynamicResource HotkeyRecorderButtonStyle}" PreviewKeyDown="HotkeyRecorderButton_PreviewKeyDown" LostKeyboardFocus="HotkeyRecorderButton_LostKeyboardFocus" ToolTip="{DynamicResource UiText3AA42ABD0BFA}" AutomationProperties.Name="{DynamicResource UiText3AA42ABD0BFA}" />
     <Button Grid.Column="2" Content="" Style="{DynamicResource IconButtonStyle}" Command="{Binding ClearHotkeyCommand}" ToolTip="{DynamicResource UiTextB22B0B3873A1}" AutomationProperties.Name="{DynamicResource UiTextB22B0B3873A1}" />
    </Grid>
    <Grid Margin="0,8,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions>
     <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" ToolTip="{DynamicResource UiTextAB16EB25D8FA}" />
     <Button Grid.Column="1" Content="{Binding LinkedApplicationName}" Command="{Binding BrowseExecutableCommand}" Style="{DynamicResource DarkThemeButtonStyle}" ToolTip="{Binding LinkedExecutablePath}" AutomationProperties.Name="{DynamicResource UiTextAC3EFCCDD707}" Padding="8,6" />
     <Button Grid.Column="2" Content="" Command="{Binding ClearExecutableCommand}" Style="{DynamicResource IconButtonStyle}" ToolTip="{DynamicResource UiTextAEFD8B03E35B}" AutomationProperties.Name="{DynamicResource UiTextAEFD8B03E35B}" />
    </Grid>
    <TextBlock Text="{Binding HotkeyStatus}" TextWrapping="Wrap" FontSize="{DynamicResource ContentFontSize}" Foreground="#F0B86E" Margin="0,8,0,0" Visibility="{Binding HasHotkeyStatus, Converter={StaticResource BoolVisibility}}" />
  </StackPanel>
 </Border>
</UserControl>
