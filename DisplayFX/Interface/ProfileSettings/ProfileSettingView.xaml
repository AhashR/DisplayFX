<UserControl x:Class="DisplayFX.Interface.ProfileSettings.ProfileSettingView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DisplayFX.Interface.ProfileSettings" Foreground="{DynamicResource TextPrimaryBrush}">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility" />
  <local:ExactColorValueConverter x:Key="ExactColorValue" />
  <Style x:Key="ExactValueStyle" TargetType="TextBox">
   <Setter Property="ToolTip" Value="Click to enter an exact value" />
   <Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="VerticalAlignment" Value="Top" /><Setter Property="MinWidth" Value="60" />
   <Setter Property="Height" Value="25" /><Setter Property="Padding" Value="4,1" />
   <Setter Property="TextAlignment" Value="Right" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
   <Setter Property="FontSize" Value="{DynamicResource ContentFontSize}" />
   <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}" /></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" /></Trigger>
   </Style.Triggers>
  </Style>
 </UserControl.Resources>

 <StackPanel>
  <TextBlock Text="Colour settings" FontWeight="SemiBold" Margin="0,0,0,6" />
  <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1" CornerRadius="6">
   <StackPanel>
    <Grid Margin="10,4">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
     <TextBlock Text="{DynamicResource UiText8D4FB8A3D94E}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
     <TextBox Grid.Column="1" x:Name="BrightnessValue" Text="{Binding Brightness, Converter={StaticResource ExactColorValue}, ConverterParameter=Brightness, Mode=OneWay}"
              Tag="Brightness" Style="{StaticResource ExactValueStyle}" AutomationProperties.Name="Brightness exact value"
              PreviewMouseLeftButtonDown="ExactValue_MouseDown" PreviewKeyDown="ExactValue_KeyDown" GotKeyboardFocus="ExactValue_GotFocus" LostKeyboardFocus="ExactValue_LostFocus" />
     <Slider Grid.Row="1" Grid.ColumnSpan="2" AutomationProperties.Name="Brightness" Style="{DynamicResource BrightnessSliderStyle}" Value="{Binding Brightness}"
             Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.05" />
    </Grid>
    <Border Height="1" Background="{DynamicResource BorderColorBrush}" />
    <Grid Margin="10,4">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
     <TextBlock Text="{DynamicResource UiText08795BA031BC}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
     <TextBox Grid.Column="1" x:Name="ContrastValue" Text="{Binding Contrast, Converter={StaticResource ExactColorValue}, ConverterParameter=Contrast, Mode=OneWay}"
              Tag="Contrast" Style="{StaticResource ExactValueStyle}" AutomationProperties.Name="Contrast exact value"
              PreviewMouseLeftButtonDown="ExactValue_MouseDown" PreviewKeyDown="ExactValue_KeyDown" GotKeyboardFocus="ExactValue_GotFocus" LostKeyboardFocus="ExactValue_LostFocus" />
     <Slider Grid.Row="1" Grid.ColumnSpan="2" AutomationProperties.Name="Contrast" Style="{DynamicResource BrightnessSliderStyle}" Value="{Binding Contrast}"
             Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.05" />
    </Grid>
    <Border Height="1" Background="{DynamicResource BorderColorBrush}" />
    <Grid Margin="10,4">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
     <TextBlock Text="{DynamicResource UiText54D47A0D2595}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
     <TextBox Grid.Column="1" x:Name="DigitalVibranceValue" Text="{Binding DigitalVibrance, Converter={StaticResource ExactColorValue}, ConverterParameter=DigitalVibrance, Mode=OneWay}"
              Tag="DigitalVibrance" Style="{StaticResource ExactValueStyle}" AutomationProperties.Name="Vibrance exact value"
              PreviewMouseLeftButtonDown="ExactValue_MouseDown" PreviewKeyDown="ExactValue_KeyDown" GotKeyboardFocus="ExactValue_GotFocus" LostKeyboardFocus="ExactValue_LostFocus" />
     <Slider Grid.Row="1" Grid.ColumnSpan="2" AutomationProperties.Name="Vibrance" Style="{DynamicResource BrightnessSliderStyle}" Value="{Binding DigitalVibrance}"
             Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.05" />
    </Grid>
    <Border Height="1" Background="{DynamicResource BorderColorBrush}" />
    <Grid Margin="10,4">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
     <TextBlock Text="{DynamicResource UiTextA8AB3D5805C9}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
     <TextBox Grid.Column="1" x:Name="GammaValue" Text="{Binding Gamma, Converter={StaticResource ExactColorValue}, ConverterParameter=Gamma, Mode=OneWay}"
              Tag="Gamma" Style="{StaticResource ExactValueStyle}" AutomationProperties.Name="Gamma exact value"
              PreviewMouseLeftButtonDown="ExactValue_MouseDown" PreviewKeyDown="ExactValue_KeyDown" GotKeyboardFocus="ExactValue_GotFocus" LostKeyboardFocus="ExactValue_LostFocus" />
     <Slider Grid.Row="1" Grid.ColumnSpan="2" AutomationProperties.Name="Gamma" Style="{DynamicResource BrightnessSliderStyle}" Value="{Binding Gamma}"
             Minimum="0.4" Maximum="2.8" SmallChange="0.01" LargeChange="0.05" />
    </Grid>

   </StackPanel>
  </Border>
  <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,8,0,0">
   <Border.Style>
    <Style TargetType="Border">
     <Style.Triggers><DataTrigger Binding="{Binding IsDefault}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
    </Style>
   </Border.Style>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <DockPanel VerticalAlignment="Center">
     <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBlueBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
     <TextBlock Text="Linked app" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
    </DockPanel>
    <Button Grid.Column="1" Command="{Binding BrowseExecutableCommand}" Style="{DynamicResource FluentButtonStyle}" MaxWidth="185"
            AutomationProperties.Name="{Binding LinkedApplicationName}" ToolTip="Choose an executable. A linked app opens its current folder.">
     <TextBlock Text="{Binding LinkedApplicationName}" TextTrimming="CharacterEllipsis" />
    </Button>
    <Button Grid.Column="2" Content="" Command="{Binding ClearExecutableCommand}" Margin="3,0,0,0"
            ToolTip="{DynamicResource UiTextAEFD8B03E35B}" AutomationProperties.Name="Unlink app"
            >
     <Button.Style>
      <Style TargetType="Button" BasedOn="{StaticResource FluentIconButtonStyle}">
       <Style.Triggers>
        <DataTrigger Binding="{Binding LinkedExecutablePath}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
        <DataTrigger Binding="{Binding LinkedExecutablePath}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
       </Style.Triggers>
      </Style>
     </Button.Style>
    </Button>
   </Grid>
  </Border>
 </StackPanel>
</UserControl>
